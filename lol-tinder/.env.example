# Скопіюй у .env.local і заповни реальними значеннями.
# Якщо проєкт залінкований з Vercel: `vercel env pull .env.local`

# --- Обов'язкові для запуску (Supabase Dashboard -> Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Серверні ---
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
GEMINI_API_KEY=

# Riot / TFT
RIOT_API_KEY=
TFT_API_KEY=
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
RIOT_REDIRECT_URI=

# Steam
STEAM_API_KEY=

# --- Опційні (базовий URL сайту) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
